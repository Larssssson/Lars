# impress – lokale Standardwerte. Mit diesen Werten startet impress ohne Zugangsdaten.
# Für Docker Compose ersetzt docker-compose.yml DATABASE_URL durch den Dienstnamen "db".

DATABASE_URL=postgresql://impress:impress@localhost:5432/impress
AUTH_SECRET=nur-lokal-nicht-geheim-bitte-im-betrieb-ersetzen
AUTH_PROVIDER=dev

# Microsoft Entra ID (bei AUTH_PROVIDER=entra; dieselbe App-Registrierung dient SharePoint)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=

DOCUMENT_STORE=mock
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ROOT_PATH=impress/Kunden

FILE_STORAGE=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL_QUALITY=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# Web Push (nur bei PUSH_PROVIDER=webpush); Schlüssel einmal erzeugen: npx web-push generate-vapid-keys
PUSH_PROVIDER=mock
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

MONITORING_SOURCE=file

APP_BASE_URL=http://localhost:3000
TZ=Europe/Berlin
# nur Ersatz-Adapter: Ablage im Dateisystem
STORAGE_DIR=./storage
